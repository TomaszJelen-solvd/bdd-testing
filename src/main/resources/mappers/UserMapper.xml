<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.solvd.bdd_automation.myBatis.iMappers.IMapperUser">
    <resultMap id="result" type="com.solvd.bdd_automation.myBatis.model.User">
        <result column="firstname" jdbcType="VARCHAR" property="name" />
        <result column="lastname" jdbcType="VARCHAR" property="surname" />
        <result column="postal_code" jdbcType="VARCHAR" property="postalCode" />
    </resultMap>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id" parameterType="com.solvd.bdd_automation.myBatis.model.User">
        INSERT INTO users (firstname, lastname, postal_code) VALUES (#{firstname}, #{surname}, #{postalCode})
    </insert>
    <update id="change" parameterType="com.solvd.bdd_automation.myBatis.model.User">
        UPDATE users SET firstname = #{firstname}, lastname = #{surname}, postal_code = #{postalCode} WHERE id = #{id}
    </update>
    <select id="readAll" resultMap="result">
        SELECT * FROM users
    </select>
    <select id="read" parameterType="long" resultMap="result">
        SELECT * FROM users WHERE id = #{id}
    </select>
    <delete id="remove" parameterType="long">
        DELETE FROM users WHERE id = #{id};
    </delete>
</mapper>